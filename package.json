{
  "name": "aplikasi-guru-desktop",
  "version": "1.0.0",
  "description": "Aplikasi Administrasi Guru & Kuis Interaktif Desktop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.eduadmin.app",
    "productName": "EduAdmin Pro",
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EduAdmin Pro"
    }
  },
  "keywords": [],
  "author": "Siska",
  "license": "ISC",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}